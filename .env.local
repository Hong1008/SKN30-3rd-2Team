# WorkShield MCP 서버 로컬 개발 환경 설정 (.env.local)
# 공개 기본 설정값이며, 실제 API 키 및 시크릿은 mcp/.env 에만 둡니다.

APP_ENV=local
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# 법제처 Open API 및 외부 MCP 설정
LAW_OC=

# 로컬 DB 및 모델 설정
DB_BASE_FILE=data/migration/contract.sqlite3
CHROMA_DIR=data/chroma
EMBEDDING_MODEL_NAME=dragonkue/BGE-m3-ko
RERANKER_MODEL_NAME=dragonkue/bge-reranker-v2-m3-ko

# RunPod 및 외부 서비스 주입용 항목 (로컬 모델 사용 시 비활성)
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_POD_BASE_URL=
# RUNPOD_EMBED_POD_TEMPLATE_ID=maqkz41mly
# RUNPOD_EMBED_POD_ID=
# RUNPOD_EMBED_POD_IMAGE=ghcr.io/hong1008/workshield-embed-rerank-pod:latest
# RUNPOD_EMBED_POD_GPU_ID=NVIDIA RTX A5000
# GITHUB_TOKEN=
# GCP_PROJECT_ID=
