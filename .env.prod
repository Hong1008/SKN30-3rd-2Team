# WorkShield MCP 서버 운영/배포 환경 설정 (.env.prod)
# 공개 기본 설정값이며, 실제 API 키 및 시크릿은 런타임 환경변수 또는 mcp/.env 에서 주입합니다.

APP_ENV=prod
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# DB 및 모델 설정
DB_BASE_FILE=data/migration/contract.sqlite3
CHROMA_DIR=data/chroma
EMBEDDING_MODEL_NAME=dragonkue/BGE-m3-ko
RERANKER_MODEL_NAME=dragonkue/bge-reranker-v2-m3-ko

# RunPod 운영 임베딩/리랭킹 연동 설정
RUNPOD_EMBED_POD_IMAGE=ghcr.io/hong1008/workshield-embed-rerank-pod:latest
# 공개 Pod proxy를 호출하는 worker 전용 key는 root 전용 mcp.env에서 주입한다.
RUNPOD_EMBED_API_KEY=
