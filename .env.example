# WorkShield MCP 서버 환경변수 예시입니다. 실제 비밀값은 로컬 .env에만 둡니다.
APP_ENV=local
LAW_OC=
KOREAN_LAW_MCP_URL=https://korean-law-mcp.fly.dev/mcp
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# RunPod Pod으로 임베딩·리랭킹을 실행할 때 사용합니다. 설정하면 Serverless보다 우선합니다.
# 예: https://<pod-id>-8000.proxy.runpod.net
RUNPOD_POD_BASE_URL=
# Pod의 POD_API_KEY와 동일한 비밀값입니다. 공개 proxy 직접 접근을 막기 위해 필수입니다.
RUNPOD_POD_API_KEY=
# `just embed-pod-template-create` / `just embed-pod-create` 결과를 기록합니다.
RUNPOD_EMBED_POD_TEMPLATE_ID=
RUNPOD_EMBED_POD_ID=
# 이미지와 GPU는 필요할 때만 기본값을 변경합니다.
# RUNPOD_EMBED_POD_IMAGE=ghcr.io/hong1008/workshield-embed-rerank-pod:latest
# RUNPOD_EMBED_POD_GPU_ID=NVIDIA RTX A5000
GITHUB_TOKEN=
GCP_PROJECT_ID=
MCP_TRANSPORT=
MCP_PORT=

# 선택 사항: 로컬 저장소·모델 경로를 바꿀 때만 지정합니다.
# DB_BASE_FILE=data/migration/contract.sqlite3
# CHROMA_DIR=data/chroma
# EMBEDDING_MODEL_NAME=dragonkue/BGE-m3-ko
# RERANKER_MODEL_NAME=dragonkue/bge-reranker-v2-m3-ko
